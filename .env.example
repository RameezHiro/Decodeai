# Frontend build/runtime API origin (local FastAPI server by default).
VITE_API_BASE_URL=http://localhost:8000

# Server-only secret: obtain it from https://aistudio.google.com/apikey
# Never prefix this key with VITE_ or expose it in frontend code.
GEMINI_API_KEY=

# Comma-separated browser origins allowed to call the backend.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
